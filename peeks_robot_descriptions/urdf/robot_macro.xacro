<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:include filename="$(find peeks_robot_descriptions)/urdf/inc/common.xacro" />

  <!-- 创建机器人描述。 -->
  <xacro:macro
    name="create_robot"
    params="robot_name
            tf_prefix
            parent
            *origin
            joint_limit_parameter_file
            robot_kinematics_parameter_file
            physical_parameter_file
            visual_parameter_file
            force_abs_path:=false">
    <xacro:read_model_config
      joint_limit_parameter_file="${joint_limit_parameter_file}"
      robot_kinematics_parameter_file="${robot_kinematics_parameter_file}"
      physical_parameter_file="${physical_parameter_file}"
      visual_parameter_file="${visual_parameter_file}"
      force_abs_path="${force_abs_path}" />

    <!-- 连杆 -->
    <link name="${tf_prefix}link_0">
      <xacro:get_mesh_param name="link_0" type="mesh_offset" />
      <visual>
        <origin
          xyz="${mesh_param['x']} ${mesh_param['y']} ${mesh_param['z']}"
          rpy="${mesh_param['roll']} ${mesh_param['pitch']} ${mesh_param['yaw']}" />
        <geometry>
          <xacro:get_mesh name="link_0" type="visual" />
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="${mesh_param['x']} ${mesh_param['y']} ${mesh_param['z']}"
          rpy="${mesh_param['roll']} ${mesh_param['pitch']} ${mesh_param['yaw']}" />
        <geometry>
          <xacro:get_mesh name="link_0" type="collision" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="${link_0_cog}" rpy="${link_0_inertia_rotation}" />
        <mass value="${link_0_mass}" />
        <inertia
          ixx="${link_0_inertia_ixx}"
          ixy="${link_0_inertia_ixy}"
          ixz="${link_0_inertia_ixz}"
          iyy="${link_0_inertia_iyy}"
          iyz="${link_0_inertia_iyz}"
          izz="${link_0_inertia_izz}" />
      </inertial>
    </link>

    <link name="${tf_prefix}link_1">
      <xacro:get_mesh_param name="link_1" type="mesh_offset" />
      <visual>
        <origin
          xyz="${mesh_param['x']} ${mesh_param['y']} ${mesh_param['z']}"
          rpy="${mesh_param['roll']} ${mesh_param['pitch']} ${mesh_param['yaw']}" />
        <geometry>
          <xacro:get_mesh name="link_1" type="visual" />
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="${mesh_param['x']} ${mesh_param['y']} ${mesh_param['z']}"
          rpy="${mesh_param['roll']} ${mesh_param['pitch']} ${mesh_param['yaw']}" />
        <geometry>
          <xacro:get_mesh name="link_1" type="collision" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="${link_1_cog}" rpy="${link_1_inertia_rotation}" />
        <mass value="${link_1_mass}" />
        <inertia
          ixx="${link_1_inertia_ixx}"
          ixy="${link_1_inertia_ixy}"
          ixz="${link_1_inertia_ixz}"
          iyy="${link_1_inertia_iyy}"
          iyz="${link_1_inertia_iyz}"
          izz="${link_1_inertia_izz}" />
      </inertial>
    </link>

    <link name="${tf_prefix}link_2">
      <xacro:get_mesh_param name="link_2" type="mesh_offset" />
      <visual>
        <origin
          xyz="${mesh_param['x']} ${mesh_param['y']} ${mesh_param['z']}"
          rpy="${mesh_param['roll']} ${mesh_param['pitch']} ${mesh_param['yaw']}" />
        <geometry>
          <xacro:get_mesh name="link_2" type="visual" />
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="${mesh_param['x']} ${mesh_param['y']} ${mesh_param['z']}"
          rpy="${mesh_param['roll']} ${mesh_param['pitch']} ${mesh_param['yaw']}" />
        <geometry>
          <xacro:get_mesh name="link_2" type="collision" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="${link_2_cog}" rpy="${link_2_inertia_rotation}" />
        <mass value="${link_2_mass}" />
        <inertia
          ixx="${link_2_inertia_ixx}"
          ixy="${link_2_inertia_ixy}"
          ixz="${link_2_inertia_ixz}"
          iyy="${link_2_inertia_iyy}"
          iyz="${link_2_inertia_iyz}"
          izz="${link_2_inertia_izz}" />
      </inertial>
    </link>

    <link name="${tf_prefix}link_3">
      <xacro:get_mesh_param name="link_3" type="mesh_offset" />
      <visual>
        <origin
          xyz="${mesh_param['x']} ${mesh_param['y']} ${mesh_param['z']}"
          rpy="${mesh_param['roll']} ${mesh_param['pitch']} ${mesh_param['yaw']}" />
        <geometry>
          <xacro:get_mesh name="link_3" type="visual" />
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="${mesh_param['x']} ${mesh_param['y']} ${mesh_param['z']}"
          rpy="${mesh_param['roll']} ${mesh_param['pitch']} ${mesh_param['yaw']}" />
        <geometry>
          <xacro:get_mesh name="link_3" type="collision" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="${link_3_cog}" rpy="${link_3_inertia_rotation}" />
        <mass value="${link_3_mass}" />
        <inertia
          ixx="${link_3_inertia_ixx}"
          ixy="${link_3_inertia_ixy}"
          ixz="${link_3_inertia_ixz}"
          iyy="${link_3_inertia_iyy}"
          iyz="${link_3_inertia_iyz}"
          izz="${link_3_inertia_izz}" />
      </inertial>
    </link>

    <link name="${tf_prefix}link_4">
      <xacro:get_mesh_param name="link_4" type="mesh_offset" />
      <visual>
        <origin
          xyz="${mesh_param['x']} ${mesh_param['y']} ${mesh_param['z']}"
          rpy="${mesh_param['roll']} ${mesh_param['pitch']} ${mesh_param['yaw']}" />
        <geometry>
          <xacro:get_mesh name="link_4" type="visual" />
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="${mesh_param['x']} ${mesh_param['y']} ${mesh_param['z']}"
          rpy="${mesh_param['roll']} ${mesh_param['pitch']} ${mesh_param['yaw']}" />
        <geometry>
          <xacro:get_mesh name="link_4" type="collision" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="${link_4_cog}" rpy="${link_4_inertia_rotation}" />
        <mass value="${link_4_mass}" />
        <inertia
          ixx="${link_4_inertia_ixx}"
          ixy="${link_4_inertia_ixy}"
          ixz="${link_4_inertia_ixz}"
          iyy="${link_4_inertia_iyy}"
          iyz="${link_4_inertia_iyz}"
          izz="${link_4_inertia_izz}" />
      </inertial>
    </link>

    <link name="${tf_prefix}link_5">
      <xacro:get_mesh_param name="link_5" type="mesh_offset" />
      <visual>
        <origin
          xyz="${mesh_param['x']} ${mesh_param['y']} ${mesh_param['z']}"
          rpy="${mesh_param['roll']} ${mesh_param['pitch']} ${mesh_param['yaw']}" />
        <geometry>
          <xacro:get_mesh name="link_5" type="visual" />
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="${mesh_param['x']} ${mesh_param['y']} ${mesh_param['z']}"
          rpy="${mesh_param['roll']} ${mesh_param['pitch']} ${mesh_param['yaw']}" />
        <geometry>
          <xacro:get_mesh name="link_5" type="collision" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="${link_5_cog}" rpy="${link_5_inertia_rotation}" />
        <mass value="${link_5_mass}" />
        <inertia
          ixx="${link_5_inertia_ixx}"
          ixy="${link_5_inertia_ixy}"
          ixz="${link_5_inertia_ixz}"
          iyy="${link_5_inertia_iyy}"
          iyz="${link_5_inertia_iyz}"
          izz="${link_5_inertia_izz}" />
      </inertial>
    </link>

    <link name="${tf_prefix}link_6">
      <xacro:get_mesh_param name="link_6" type="mesh_offset" />
      <visual>
        <origin
          xyz="${mesh_param['x']} ${mesh_param['y']} ${mesh_param['z']}"
          rpy="${mesh_param['roll']} ${mesh_param['pitch']} ${mesh_param['yaw']}" />
        <geometry>
          <xacro:get_mesh name="link_6" type="visual" />
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="${mesh_param['x']} ${mesh_param['y']} ${mesh_param['z']}"
          rpy="${mesh_param['roll']} ${mesh_param['pitch']} ${mesh_param['yaw']}" />
        <geometry>
          <xacro:get_mesh name="link_6" type="collision" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="${link_6_cog}" rpy="${link_6_inertia_rotation}" />
        <mass value="${link_6_mass}" />
        <inertia
          ixx="${link_6_inertia_ixx}"
          ixy="${link_6_inertia_ixy}"
          ixz="${link_6_inertia_ixz}"
          iyy="${link_6_inertia_iyy}"
          iyz="${link_6_inertia_iyz}"
          izz="${link_6_inertia_izz}" />
      </inertial>
    </link>

    <!-- 关节 -->
    <joint name="${tf_prefix}joint_0" type="fixed">
      <parent link="${parent}" />
      <child link="${tf_prefix}link_0" />
      <xacro:insert_block name="origin" />
    </joint>

    <joint name="${tf_prefix}joint_1" type="revolute">
      <parent link="${tf_prefix}link_0" />
      <child link="${tf_prefix}link_1" />
      <origin
        xyz="${joint_1_x} ${joint_1_y} ${joint_1_z}"
        rpy="${joint_1_roll} ${joint_1_pitch} ${joint_1_yaw}" />
      <axis xyz="0 0 1" />
      <limit
        lower="${joint_1_lower_limit}"
        upper="${joint_1_upper_limit}"
        velocity="${joint_1_velocity_limit}"
        effort="${joint_1_effort_limit}" />
      <dynamics damping="0" friction="0" />
    </joint>

    <joint name="${tf_prefix}joint_2" type="revolute">
      <parent link="${tf_prefix}link_1" />
      <child link="${tf_prefix}link_2" />
      <origin
        xyz="${joint_2_x} ${joint_2_y} ${joint_2_z}"
        rpy="${joint_2_roll} ${joint_2_pitch} ${joint_2_yaw}" />
      <axis xyz="0 0 1" />
      <limit
        lower="${joint_2_lower_limit}"
        upper="${joint_2_upper_limit}"
        velocity="${joint_2_velocity_limit}"
        effort="${joint_2_effort_limit}" />
      <dynamics damping="0" friction="0" />
    </joint>

    <joint name="${tf_prefix}joint_3" type="revolute">
      <parent link="${tf_prefix}link_2" />
      <child link="${tf_prefix}link_3" />
      <origin
        xyz="${joint_3_x} ${joint_3_y} ${joint_3_z}"
        rpy="${joint_3_roll} ${joint_3_pitch} ${joint_3_yaw}" />
      <axis xyz="0 0 1" />
      <limit
        lower="${joint_3_lower_limit}"
        upper="${joint_3_upper_limit}"
        velocity="${joint_3_velocity_limit}"
        effort="${joint_3_effort_limit}" />
      <dynamics damping="0" friction="0" />
    </joint>

    <joint name="${tf_prefix}joint_4" type="revolute">
      <parent link="${tf_prefix}link_3" />
      <child link="${tf_prefix}link_4" />
      <origin
        xyz="${joint_4_x} ${joint_4_y} ${joint_4_z}"
        rpy="${joint_4_roll} ${joint_4_pitch} ${joint_4_yaw}" />
      <axis xyz="0 0 1" />
      <limit
        lower="${joint_4_lower_limit}"
        upper="${joint_4_upper_limit}"
        velocity="${joint_4_velocity_limit}"
        effort="${joint_4_effort_limit}" />
      <dynamics damping="0" friction="0" />
    </joint>

    <joint name="${tf_prefix}joint_5" type="revolute">
      <parent link="${tf_prefix}link_4" />
      <child link="${tf_prefix}link_5" />
      <origin
        xyz="${joint_5_x} ${joint_5_y} ${joint_5_z}"
        rpy="${joint_5_roll} ${joint_5_pitch} ${joint_5_yaw}" />
      <axis xyz="0 0 1" />
      <limit
        lower="${joint_5_lower_limit}"
        upper="${joint_5_upper_limit}"
        velocity="${joint_5_velocity_limit}"
        effort="${joint_5_effort_limit}" />
      <dynamics damping="0" friction="0" />
    </joint>

    <joint name="${tf_prefix}joint_6" type="revolute">
      <parent link="${tf_prefix}link_5" />
      <child link="${tf_prefix}link_6" />
      <origin
        xyz="${joint_6_x} ${joint_6_y} ${joint_6_z}"
        rpy="${joint_6_roll} ${joint_6_pitch} ${joint_6_yaw}" />
      <axis xyz="0 0 1" />
      <limit
        lower="${joint_6_lower_limit}"
        upper="${joint_6_upper_limit}"
        velocity="${joint_6_velocity_limit}"
        effort="${joint_6_effort_limit}" />
      <dynamics damping="0" friction="0" />
    </joint>
  </xacro:macro>
</robot>