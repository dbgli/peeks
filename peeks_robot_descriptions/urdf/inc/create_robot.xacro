<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:include filename="$(find peeks_robot_descriptions)/urdf/inc/common.xacro" />

  <!-- 创建机器人描述。 -->
  <xacro:macro
    name="create_robot"
    params="robot_name
            tf_prefix
            parent
            *origin
            joint_limit_parameter_file
            default_kinematics_parameter_file
            physical_parameter_file
            visual_parameter_file
            force_abs_path:=false">
    <xacro:read_robot_config
      joint_limit_parameter_file="${joint_limit_parameter_file}"
      default_kinematics_parameter_file="${default_kinematics_parameter_file}"
      physical_parameter_file="${physical_parameter_file}"
      visual_parameter_file="${visual_parameter_file}"
      force_abs_path="${force_abs_path}" />

    <!-- 连杆 -->
    <link name="${tf_prefix}base_link">
      <xacro:get_mesh_param name="base" type="mesh_offset" />
      <visual>
        <origin
          xyz="${mesh_param['x']} ${mesh_param['y']} ${mesh_param['z']}"
          rpy="${mesh_param['roll']} ${mesh_param['pitch']} ${mesh_param['yaw']}" />
        <geometry>
          <xacro:get_mesh name="base" type="visual" />
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="${mesh_param['x']} ${mesh_param['y']} ${mesh_param['z']}"
          rpy="${mesh_param['roll']} ${mesh_param['pitch']} ${mesh_param['yaw']}" />
        <geometry>
          <xacro:get_mesh name="base" type="collision" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="${base_cog}" rpy="${base_inertia_rotation}" />
        <mass value="${base_mass}" />
        <inertia
          ixx="${base_inertia_ixx}"
          ixy="${base_inertia_ixy}"
          ixz="${base_inertia_ixz}"
          iyy="${base_inertia_iyy}"
          iyz="${base_inertia_iyz}"
          izz="${base_inertia_izz}" />
      </inertial>
    </link>

    <link name="${tf_prefix}shoulder_link">
      <xacro:get_mesh_param name="shoulder" type="mesh_offset" />
      <visual>
        <origin
          xyz="${mesh_param['x']} ${mesh_param['y']} ${mesh_param['z']}"
          rpy="${mesh_param['roll']} ${mesh_param['pitch']} ${mesh_param['yaw']}" />
        <geometry>
          <xacro:get_mesh name="shoulder" type="visual" />
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="${mesh_param['x']} ${mesh_param['y']} ${mesh_param['z']}"
          rpy="${mesh_param['roll']} ${mesh_param['pitch']} ${mesh_param['yaw']}" />
        <geometry>
          <xacro:get_mesh name="shoulder" type="collision" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="${shoulder_cog}" rpy="${shoulder_inertia_rotation}" />
        <mass value="${shoulder_mass}" />
        <inertia
          ixx="${shoulder_inertia_ixx}"
          ixy="${shoulder_inertia_ixy}"
          ixz="${shoulder_inertia_ixz}"
          iyy="${shoulder_inertia_iyy}"
          iyz="${shoulder_inertia_iyz}"
          izz="${shoulder_inertia_izz}" />
      </inertial>
    </link>

    <link name="${tf_prefix}upper_arm_link">
      <xacro:get_mesh_param name="upper_arm" type="mesh_offset" />
      <visual>
        <origin
          xyz="${mesh_param['x']} ${mesh_param['y']} ${mesh_param['z']}"
          rpy="${mesh_param['roll']} ${mesh_param['pitch']} ${mesh_param['yaw']}" />
        <geometry>
          <xacro:get_mesh name="upper_arm" type="visual" />
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="${mesh_param['x']} ${mesh_param['y']} ${mesh_param['z']}"
          rpy="${mesh_param['roll']} ${mesh_param['pitch']} ${mesh_param['yaw']}" />
        <geometry>
          <xacro:get_mesh name="upper_arm" type="collision" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="${upper_arm_cog}" rpy="${upper_arm_inertia_rotation}" />
        <mass value="${upper_arm_mass}" />
        <inertia
          ixx="${upper_arm_inertia_ixx}"
          ixy="${upper_arm_inertia_ixy}"
          ixz="${upper_arm_inertia_ixz}"
          iyy="${upper_arm_inertia_iyy}"
          iyz="${upper_arm_inertia_iyz}"
          izz="${upper_arm_inertia_izz}" />
      </inertial>
    </link>

    <link name="${tf_prefix}forearm_link">
      <xacro:get_mesh_param name="forearm" type="mesh_offset" />
      <visual>
        <origin
          xyz="${mesh_param['x']} ${mesh_param['y']} ${mesh_param['z']}"
          rpy="${mesh_param['roll']} ${mesh_param['pitch']} ${mesh_param['yaw']}" />
        <geometry>
          <xacro:get_mesh name="forearm" type="visual" />
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="${mesh_param['x']} ${mesh_param['y']} ${mesh_param['z']}"
          rpy="${mesh_param['roll']} ${mesh_param['pitch']} ${mesh_param['yaw']}" />
        <geometry>
          <xacro:get_mesh name="forearm" type="collision" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="${forearm_cog}" rpy="${forearm_inertia_rotation}" />
        <mass value="${forearm_mass}" />
        <inertia
          ixx="${forearm_inertia_ixx}"
          ixy="${forearm_inertia_ixy}"
          ixz="${forearm_inertia_ixz}"
          iyy="${forearm_inertia_iyy}"
          iyz="${forearm_inertia_iyz}"
          izz="${forearm_inertia_izz}" />
      </inertial>
    </link>

    <link name="${tf_prefix}wrist_1_link">
      <xacro:get_mesh_param name="wrist_1" type="mesh_offset" />
      <visual>
        <origin
          xyz="${mesh_param['x']} ${mesh_param['y']} ${mesh_param['z']}"
          rpy="${mesh_param['roll']} ${mesh_param['pitch']} ${mesh_param['yaw']}" />
        <geometry>
          <xacro:get_mesh name="wrist_1" type="visual" />
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="${mesh_param['x']} ${mesh_param['y']} ${mesh_param['z']}"
          rpy="${mesh_param['roll']} ${mesh_param['pitch']} ${mesh_param['yaw']}" />
        <geometry>
          <xacro:get_mesh name="wrist_1" type="collision" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="${wrist_1_cog}" rpy="${wrist_1_inertia_rotation}" />
        <mass value="${wrist_1_mass}" />
        <inertia
          ixx="${wrist_1_inertia_ixx}"
          ixy="${wrist_1_inertia_ixy}"
          ixz="${wrist_1_inertia_ixz}"
          iyy="${wrist_1_inertia_iyy}"
          iyz="${wrist_1_inertia_iyz}"
          izz="${wrist_1_inertia_izz}" />
      </inertial>
    </link>

    <link name="${tf_prefix}wrist_2_link">
      <xacro:get_mesh_param name="wrist_2" type="mesh_offset" />
      <visual>
        <origin
          xyz="${mesh_param['x']} ${mesh_param['y']} ${mesh_param['z']}"
          rpy="${mesh_param['roll']} ${mesh_param['pitch']} ${mesh_param['yaw']}" />
        <geometry>
          <xacro:get_mesh name="wrist_2" type="visual" />
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="${mesh_param['x']} ${mesh_param['y']} ${mesh_param['z']}"
          rpy="${mesh_param['roll']} ${mesh_param['pitch']} ${mesh_param['yaw']}" />
        <geometry>
          <xacro:get_mesh name="wrist_2" type="collision" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="${wrist_2_cog}" rpy="${wrist_2_inertia_rotation}" />
        <mass value="${wrist_2_mass}" />
        <inertia
          ixx="${wrist_2_inertia_ixx}"
          ixy="${wrist_2_inertia_ixy}"
          ixz="${wrist_2_inertia_ixz}"
          iyy="${wrist_2_inertia_iyy}"
          iyz="${wrist_2_inertia_iyz}"
          izz="${wrist_2_inertia_izz}" />
      </inertial>
    </link>

    <link name="${tf_prefix}wrist_3_link">
      <xacro:get_mesh_param name="wrist_3" type="mesh_offset" />
      <visual>
        <origin
          xyz="${mesh_param['x']} ${mesh_param['y']} ${mesh_param['z']}"
          rpy="${mesh_param['roll']} ${mesh_param['pitch']} ${mesh_param['yaw']}" />
        <geometry>
          <xacro:get_mesh name="wrist_3" type="visual" />
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="${mesh_param['x']} ${mesh_param['y']} ${mesh_param['z']}"
          rpy="${mesh_param['roll']} ${mesh_param['pitch']} ${mesh_param['yaw']}" />
        <geometry>
          <xacro:get_mesh name="wrist_3" type="collision" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="${wrist_3_cog}" rpy="${wrist_3_inertia_rotation}" />
        <mass value="${wrist_3_mass}" />
        <inertia
          ixx="${wrist_3_inertia_ixx}"
          ixy="${wrist_3_inertia_ixy}"
          ixz="${wrist_3_inertia_ixz}"
          iyy="${wrist_3_inertia_iyy}"
          iyz="${wrist_3_inertia_iyz}"
          izz="${wrist_3_inertia_izz}" />
      </inertial>
    </link>

    <link name="${tf_prefix}flange_link" />

    <!-- 关节 -->
    <joint name="${tf_prefix}base_joint" type="fixed">
      <parent link="${parent}" />
      <child link="${tf_prefix}base_link" />
      <xacro:insert_block name="origin" />
    </joint>

    <joint name="${tf_prefix}shoulder_joint" type="revolute">
      <parent link="${tf_prefix}base_link" />
      <child link="${tf_prefix}shoulder_link" />
      <origin
        xyz="${shoulder_x} ${shoulder_y} ${shoulder_z}"
        rpy="${shoulder_roll} ${shoulder_pitch} ${shoulder_yaw}" />
      <axis xyz="0 0 1" />
      <limit
        lower="${shoulder_lower_limit}"
        upper="${shoulder_upper_limit}"
        velocity="${shoulder_velocity_limit}"
        effort="${shoulder_effort_limit}" />
      <dynamics damping="0" friction="0" />
    </joint>

    <joint name="${tf_prefix}upper_arm_joint" type="revolute">
      <parent link="${tf_prefix}shoulder_link" />
      <child link="${tf_prefix}upper_arm_link" />
      <origin
        xyz="${upper_arm_x} ${upper_arm_y} ${upper_arm_z}"
        rpy="${upper_arm_roll} ${upper_arm_pitch} ${upper_arm_yaw}" />
      <axis xyz="0 0 1" />
      <limit
        lower="${upper_arm_lower_limit}"
        upper="${upper_arm_upper_limit}"
        velocity="${upper_arm_velocity_limit}"
        effort="${upper_arm_effort_limit}" />
      <dynamics damping="0" friction="0" />
    </joint>

    <joint name="${tf_prefix}forearm_joint" type="revolute">
      <parent link="${tf_prefix}upper_arm_link" />
      <child link="${tf_prefix}forearm_link" />
      <origin
        xyz="${forearm_x} ${forearm_y} ${forearm_z}"
        rpy="${forearm_roll} ${forearm_pitch} ${forearm_yaw}" />
      <axis xyz="0 0 1" />
      <limit
        lower="${forearm_lower_limit}"
        upper="${forearm_upper_limit}"
        velocity="${forearm_velocity_limit}"
        effort="${forearm_effort_limit}" />
      <dynamics damping="0" friction="0" />
    </joint>

    <joint name="${tf_prefix}wrist_1_joint" type="revolute">
      <parent link="${tf_prefix}forearm_link" />
      <child link="${tf_prefix}wrist_1_link" />
      <origin
        xyz="${wrist_1_x} ${wrist_1_y} ${wrist_1_z}"
        rpy="${wrist_1_roll} ${wrist_1_pitch} ${wrist_1_yaw}" />
      <axis xyz="0 0 1" />
      <limit
        lower="${wrist_1_lower_limit}"
        upper="${wrist_1_upper_limit}"
        velocity="${wrist_1_velocity_limit}"
        effort="${wrist_1_effort_limit}" />
      <dynamics damping="0" friction="0" />
    </joint>

    <joint name="${tf_prefix}wrist_2_joint" type="revolute">
      <parent link="${tf_prefix}wrist_1_link" />
      <child link="${tf_prefix}wrist_2_link" />
      <origin
        xyz="${wrist_2_x} ${wrist_2_y} ${wrist_2_z}"
        rpy="${wrist_2_roll} ${wrist_2_pitch} ${wrist_2_yaw}" />
      <axis xyz="0 0 1" />
      <limit
        lower="${wrist_2_lower_limit}"
        upper="${wrist_2_upper_limit}"
        velocity="${wrist_2_velocity_limit}"
        effort="${wrist_2_effort_limit}" />
      <dynamics damping="0" friction="0" />
    </joint>

    <joint name="${tf_prefix}wrist_3_joint" type="revolute">
      <parent link="${tf_prefix}wrist_2_link" />
      <child link="${tf_prefix}wrist_3_link" />
      <origin
        xyz="${wrist_3_x} ${wrist_3_y} ${wrist_3_z}"
        rpy="${wrist_3_roll} ${wrist_3_pitch} ${wrist_3_yaw}" />
      <axis xyz="0 0 1" />
      <limit
        lower="${wrist_3_lower_limit}"
        upper="${wrist_3_upper_limit}"
        velocity="${wrist_3_velocity_limit}"
        effort="${wrist_3_effort_limit}" />
      <dynamics damping="0" friction="0" />
    </joint>

    <joint name="${tf_prefix}flange_joint" type="fixed">
      <parent link="${tf_prefix}wrist_3_link" />
      <child link="${tf_prefix}flange_link" />
      <origin
        xyz="${flange_x} ${flange_y} ${flange_z}"
        rpy="${flange_roll} ${flange_pitch} ${flange_yaw}" />
    </joint>
  </xacro:macro>
</robot>